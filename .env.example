# Copie este arquivo para .env.local e preencha com os valores reais.
# O .env.local NUNCA é versionado.

# URL do projeto Supabase (ex.: https://<project_ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (painel Supabase -> Settings -> API -> anon public)
# NUNCA use a service_role key aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOMENTE no servidor (route handlers / server actions).
# NUNCA prefixar com NEXT_PUBLIC_, NUNCA usar no frontend.
SUPABASE_SERVICE_ROLE_KEY=
